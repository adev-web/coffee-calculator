---
import { version } from "../../package.json";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculadora de Café</title>
  </head>
  <body>
    <div class="card">
      <h1>☕ Calculadora de Café</h1>

      <div class="field">
        <label for="preparation">Tipo de preparación</label>
        <select id="preparation">
          <option value="personalizado">Personalizado</option>
          <option value="frenchPress">Prensa Francesa</option>
          <option value="pourOver">Pour Over (V60 / Chemex)</option>
          <option value="drip">Cafetera Americana</option>
          <option value="aeropress">Aeropress</option>
          <option value="moka">Moka Pot</option>
          <option value="espresso">Espresso</option>
        </select>
      </div>

      <div class="field">
        <label for="ratio">Ratio (agua:café)</label>
        <input type="number" id="ratio" min="0" step="1" placeholder="Mililitros de agua por cada gramo de café" />
      </div>

      <div class="field">
        <label for="param">Parámetro de entrada</label>
        <select id="param">
          <option value="grams">Gramos de café</option>
          <option value="milliliters">Mililitros de agua</option>
        </select>
      </div>

      <div class="field">
        <label for="value">Valor</label>
        <input type="number" id="value" min="0" step="0.1" />
      </div>

      <div class="field">
        <label for="brewTime">Tiempo de extracción (MM:SS)</label>
        <input type="text" id="brewTime" placeholder="MM:SS" maxlength="5" value="00:00" />
      </div>

      <button id="calculate" class="calc-btn">Calcular</button>

      <p id="result" class="result"></p>

      <div id="timerSection" class="timer-section hidden">
        <div id="timerDisplay" class="timer-display">00:00</div>
        <button id="timerBtn" class="timer-btn">Iniciar</button>
      </div>

      <footer class="footer">
        <span>v{version}</span>
        <span>Ratios de referencia: <a href="https://sca.coffee" target="_blank" rel="noopener">Specialty Coffee Association (SCA)</a></span>
      </footer>
    </div>

    <script>
      import { init_app } from "../app.js";
      init_app();
    </script>

    <style>
      :root {
        --bg: #121212;
        --surface: #1e1e1e;
        --border: #333;
        --text: #e0e0e0;
        --muted: #888;
        --accent: #a0785a;
        --accent-hover: #b89170;
        --radius: 12px;
        --alarm: #e74c3c;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .card {
        background: var(--surface);
        border-radius: var(--radius);
        padding: 2rem 1.5rem;
        width: 100%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      h1 {
        font-size: 1.4rem;
        font-weight: 600;
        text-align: center;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      label {
        font-size: 0.85rem;
        color: var(--muted);
        font-weight: 500;
      }

      select,
      input:where([type="number"], [type="text"]) {
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.7rem 0.9rem;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s;
      }

      select:focus,
      input:where([type="number"], [type="text"]):focus {
        border-color: var(--accent);
      }

      input[type="number"]::-webkit-inner-spin-button,
      input[type="number"]::-webkit-outer-spin-button {
        opacity: 1;
      }

      .calc-btn {
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: var(--radius);
        padding: 0.8rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      .calc-btn:hover {
        background: var(--accent-hover);
      }

      .result {
        text-align: center;
        font-size: 0.95rem;
        color: var(--accent);
        min-height: 1.5em;
      }

      .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.1rem;
        font-size: 0.65rem;
        color: var(--muted);
      }
      .footer a {
        color: var(--muted);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .footer a:hover {
        color: var(--accent);
      }

      /* ---------- timer ---------- */
      .timer-section.hidden {
        display: none;
      }

      .timer-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
      }

      .timer-display {
        font-size: 3rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.1em;
        color: var(--text);
        transition: color 0.15s;
      }

      .timer-display.alarm {
        color: var(--alarm);
        animation: pulse 0.6s ease-in-out infinite alternate;
      }

      @keyframes pulse {
        0% {
          opacity: 1;
          transform: scale(1);
        }
        100% {
          opacity: 0.3;
          transform: scale(1.08);
        }
      }

      .timer-btn {
        background: transparent;
        color: var(--accent);
        border: 2px solid var(--accent);
        border-radius: var(--radius);
        padding: 0.5rem 2rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
      }

      .timer-btn:hover {
        background: var(--accent);
        color: #fff;
      }
    </style>
  </body>
</html>
