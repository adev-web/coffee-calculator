---
// Coffee Calculator — single-page Astro app
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculadora de Café</title>
  </head>
  <body>
    <div class="card">
      <h1>☕ Calculadora de Café</h1>

      <div class="field">
        <label for="preparation">Tipo de preparación</label>
        <select id="preparation">
          <option value="french-press">Prensa Francesa</option>
        </select>
      </div>

      <div class="field">
        <label for="ratio">Ratio (agua:café)</label>
        <input type="number" id="ratio" min="1" step="1" value="16" />
      </div>

      <div class="field">
        <label for="param">Parámetro de entrada</label>
        <select id="param">
          <option value="grams">Gramos de café</option>
          <option value="milliliters">Mililitros de agua</option>
        </select>
      </div>

      <div class="field">
        <label for="value">Valor</label>
        <input type="number" id="value" min="0" step="0.1" placeholder="0" />
      </div>

      <button id="calculate">Calcular</button>

      <p id="result" class="result"></p>
    </div>

    <script>
      const ratioInput = document.getElementById("ratio");
      const paramSelect = document.getElementById("param");
      const valueInput = document.getElementById("value");
      const result = document.getElementById("result");

      function clampPositive(v) {
        return v < 0 ? 0 : v;
      }

      [ratioInput, valueInput].forEach((input) => {
        input.addEventListener("input", () => {
          const val = parseFloat(input.value);
          if (input.value !== "" && (isNaN(val) || val < 0)) {
            input.value = 0;
          }
        });
      });

      document.getElementById("calculate").addEventListener("click", () => {
        const ratio = parseFloat(ratioInput.value) || 16;
        const value = parseFloat(valueInput.value);
        const param = paramSelect.value;

        if (!value) {
          result.textContent = "Ingresa un valor para calcular.";
          return;
        }

        if (param === "grams") {
          const ml = clampPositive(value * ratio);
          result.textContent = `${value}g café → ${ml.toFixed(1)}ml agua (1:${ratio})`;
        } else {
          const grams = clampPositive(value / ratio);
          result.textContent = `${value}ml agua → ${grams.toFixed(1)}g café (1:${ratio})`;
        }
      });
    </script>

    <style>
      :root {
        --bg: #121212;
        --surface: #1e1e1e;
        --border: #333;
        --text: #e0e0e0;
        --muted: #888;
        --accent: #a0785a;
        --accent-hover: #b89170;
        --radius: 12px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .card {
        background: var(--surface);
        border-radius: var(--radius);
        padding: 2rem 1.5rem;
        width: 100%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      h1 {
        font-size: 1.4rem;
        font-weight: 600;
        text-align: center;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      label {
        font-size: 0.85rem;
        color: var(--muted);
        font-weight: 500;
      }

      select,
      input[type="number"] {
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.7rem 0.9rem;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s;
      }

      select:focus,
      input[type="number"]:focus {
        border-color: var(--accent);
      }

      input[type="number"]::-webkit-inner-spin-button,
      input[type="number"]::-webkit-outer-spin-button {
        opacity: 1;
      }

      button {
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: var(--radius);
        padding: 0.8rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      button:hover {
        background: var(--accent-hover);
      }

      .result {
        text-align: center;
        font-size: 0.95rem;
        color: var(--accent);
        min-height: 1.5em;
      }
    </style>
  </body>
</html>
